APP_NAME=JVM Technologies AI
JWT_SECRET=change-this-to-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./jvm_ai.db

# ollama or openai_compatible
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_MODEL=llama3.2
AI_TIMEOUT_SECONDS=120

# Comma-separated allowed browser origins. Same-origin is enough for the included UI.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
